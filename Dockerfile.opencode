FROM ghcr.io/anomalyco/opencode:latest

# Install Node.js, npm, and pnpm
RUN apk add --no-cache nodejs npm && \
    npm install -g pnpm

# Install llama.cpp plugin into opencode's config directory
RUN mkdir -p /root/.config/opencode && \
    cd /root/.config/opencode && \
    npm install opencode-plugin-llama.cpp@latest && \
    echo "y" | pnpm approve-builds

# Verify installation
RUN node --version && npm --version && pnpm --version

# Enable debug logging for detailed session output
CMD [ "serve", "--port", "4096", "--hostname", "0.0.0.0",  "--log-level", "DEBUG" ]

