FROM ghcr.io/anomalyco/opencode:latest

# Install Node.js and npm (needed for MCP servers)
RUN apk add --no-cache nodejs npm

# Verify installation
RUN node --version && npm --version

# Enable debug logging for detailed session output
CMD ["--log-level", "DEBUG", "serve", "--port", "4096", "--hostname", "0.0.0.0"]

